# ==============================================================================
# Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ==============================================================================

# API Gateway URL
# The base URL of the backend API Gateway service
# Development: Usually http://localhost:8080
# Production: Your deployed API URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# Payment Provider
# Which payment provider to use for checkout
# 'mock' - Simulates payment flow locally (default for development)
# 'api'  - Routes through backend to real provider (for production)
NEXT_PUBLIC_PAYMENT_PROVIDER=mock

# Authentication Provider
# Which authentication strategy to use for sign-in (see src/services/auth/).
# 'api'        - Username/password against our backend session API (default)
# 'google'     - Google sign-in, proxied through the backend
#                (requires backend GET /api/auth/google/start)
# 'microsoft'  - Microsoft sign-in, proxied through the backend
# 'mock-oauth' - Simulates a third-party redirect sign-in locally (development)
NEXT_PUBLIC_AUTH_PROVIDER=api

